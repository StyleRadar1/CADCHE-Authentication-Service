        <mxCell id="hex_app" value="&lt;b&gt;2. PUERTOS IN (&lt;code&gt;domain/port/in&lt;/code&gt;) Y CAPA DE APLICACIÓN (&lt;code&gt;application/usecase, service/impl, mapper/in-out&lt;/code&gt;)&lt;/b&gt;&lt;br&gt;Interfaces &lt;code&gt;*UseCase&lt;/code&gt; + &lt;code&gt;*UseCaseImpl&lt;/code&gt;, Mappers In/Out divididos e Interfaces &lt;code&gt;*Service&lt;/code&gt; + &lt;code&gt;*ServiceImpl&lt;/code&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
