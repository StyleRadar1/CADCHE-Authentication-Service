        <!-- CONTENEDOR PRINCIPAL DEL MICROSERVICIO -->
        <mxCell id="node_ms" value="&lt;b&gt;ms-auth — Microservicio de Autenticación (edu.dosw.styleradar.auth · Arquitectura Hexagonal · Puerto 8081)&lt;/b&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fillColor=#ffffff;strokeColor=#333333;fontSize=14;" vertex="1" parent="1">
