# ==============================================================================
# STYLERADAR · ms-auth · PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# Nunca subir archivos .env con credenciales reales al repositorio.
# ==============================================================================

# Puerto y perfil de ejecucion (dev | qa | prod)
SERVER_PORT=8100
SPRING_PROFILES_ACTIVE=dev

# ms-auth no usa base de datos relacional (ADR: stateless con Redis 7; las cuentas son de ms-usuarios)
# OTP, bloqueos, lista negra de JWT, estado OAuth2 y rate limiting distribuido (Redis 7)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Politica del codigo OTP (SR-RF-92): espera tras 3 fallos y vida de la verificacion en curso
OTP_LOCKOUT_SECONDS=60
OTP_SESSION_TTL_SECONDS=900

# Broker de mensajeria RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=CAMBIAR_ESTA_CLAVE

# Seguridad JWT y CORS (OBLIGATORIO usar secreto >= 32 bytes Base64 en QA/PROD)
JWT_SECRET_BASE64=REEMPLAZAR_POR_SECRETO_ALEATORIO_MIN_256_BITS_EN_BASE64
JWT_DURATION=PT24H
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Servidor SMTP de correo saliente
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=styleradar1@gmail.com
MAIL_PASSWORD=TU_CONTRASENA_O_APP_PASSWORD

# Comunicacion interna con ms-usuarios
USUARIOS_SERVICE_URL=http://localhost:8120
USUARIOS_CREDENCIALES_PATH=/api/v1/internal/users/verify-credentials
USUARIOS_OAUTH2_PATH=/api/v1/internal/users/oauth2
USUARIOS_CORREO_VERIFICADO_PATH=/api/v1/internal/users/{id}/email-verification
USUARIOS_INTERNAL_USERNAME=ms-auth
USUARIOS_INTERNAL_PASSWORD=TU_CLAVE_INTERNA

# Autenticacion federada con Google OAuth2 / OpenID Connect
GOOGLE_CLIENT_ID=TU_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=TU_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:8100/api/v1/auth/oauth2/google/callback
GOOGLE_ALLOWED_REDIRECT_URIS=http://localhost:8100/api/v1/auth/oauth2/google/callback,http://localhost:3000/auth/google/callback
GOOGLE_STATE_TTL_SECONDS=300
